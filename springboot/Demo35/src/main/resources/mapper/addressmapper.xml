<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.item.demo35.Dao.AddressDao">
    <resultMap id="addressMap" type="com.example.item.demo35.entity.Address">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="receiverName" column="receiver_name"/>
        <result property="receiverPhone" column="receiver_phone"/>
        <result property="province" column="province"/>
        <result property="city" column="city"/>
        <result property="district" column="district"/>
        <result property="detailAddress" column="detail_address"/>
        <result property="isDefault" column="is_default"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectByUserId" resultMap="addressMap">
        select * from address where user_id = #{userId} order by is_default desc, create_time desc
    </select>

    <select id="selectById" resultMap="addressMap">
        select * from address where id = #{id}
    </select>

    <select id="selectDefaultByUserId" resultMap="addressMap">
        select * from address where user_id = #{userId} and is_default = 1 limit 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into address(user_id, receiver_name, receiver_phone, province, city, district, detail_address, is_default)
        values(#{userId}, #{receiverName}, #{receiverPhone}, #{province}, #{city}, #{district}, #{detailAddress}, #{isDefault})
    </insert>

    <update id="update">
        update address
        <set>
            <if test="receiverName != null and receiverName != ''">receiver_name = #{receiverName},</if>
            <if test="receiverPhone != null and receiverPhone != ''">receiver_phone = #{receiverPhone},</if>
            <if test="province != null and province != ''">province = #{province},</if>
            <if test="city != null and city != ''">city = #{city},</if>
            <if test="district != null and district != ''">district = #{district},</if>
            <if test="detailAddress != null and detailAddress != ''">detail_address = #{detailAddress},</if>
            <if test="isDefault != null">is_default = #{isDefault},</if>
        </set>
        where id = #{id}
    </update>

    <update id="setDefault">
        update address set is_default = 0 where user_id = #{userId};
        update address set is_default = 1 where id = #{id}
    </update>

    <delete id="delete">
        delete from address where id = #{id}
    </delete>
</mapper>