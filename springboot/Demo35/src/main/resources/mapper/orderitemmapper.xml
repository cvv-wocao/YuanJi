<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.item.demo35.Dao.OrderItemDao">
    <resultMap id="orderItemMap" type="com.example.item.demo35.entity.OrderItem">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="productId" column="product_id"/>
        <result property="productName" column="product_name"/>
        <result property="productImage" column="product_image"/>
        <result property="price" column="price"/>
        <result property="quantity" column="quantity"/>
        <result property="totalPrice" column="total_price"/>
        <result property="specification" column="specification"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByOrderId" resultMap="orderItemMap">
        select * from order_item where order_id = #{orderId}
    </select>

    <select id="selectByUserId" resultMap="orderItemMap">
        select oi.* from order_item oi
        inner join `order` o on oi.order_id = o.id
        where o.user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into order_item(order_id, product_id, product_name, product_image, price, quantity, total_price, specification)
        values(#{orderId}, #{productId}, #{productName}, #{productImage}, #{price}, #{quantity}, #{totalPrice}, #{specification})
    </insert>

    <delete id="delete">
        delete from order_item where order_id = #{orderId}
    </delete>
</mapper>