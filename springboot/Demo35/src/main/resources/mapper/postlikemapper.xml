<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.item.demo35.Dao.PostLikeDao">
    <resultMap id="postLikeMap" type="com.example.item.demo35.entity.PostLike">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="likePost">
        INSERT INTO post_like(post_id, user_id)
        VALUES(#{postId}, #{userId})
    </insert>

    <delete id="unlikePost">
        DELETE FROM post_like WHERE post_id = #{postId} AND user_id = #{userId}
    </delete>

    <select id="selectByPostAndUser" resultMap="postLikeMap">
        SELECT * FROM post_like WHERE post_id = #{postId} AND user_id = #{userId}
    </select>

    <select id="selectByPostId" resultMap="postLikeMap">
        SELECT * FROM post_like WHERE post_id = #{postId}
    </select>

    <select id="selectByUserId" resultMap="postLikeMap">
        SELECT * FROM post_like WHERE user_id = #{userId}
    </select>

    <select id="isLiked" resultType="boolean">
        SELECT COUNT(*) > 0 FROM post_like
        WHERE post_id = #{postId} AND user_id = #{userId}
    </select>

    <select id="countByPostId" resultType="int">
        SELECT COUNT(*) FROM post_like WHERE post_id = #{postId}
    </select>
</mapper>
