<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.item.demo35.Dao.ProductCategoryDao">
    <resultMap id="productCategoryMap" type="com.example.item.demo35.entity.ProductCategory">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="parentId" column="parent_id"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="icon" column="icon"/>
        <result property="description" column="description"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectAllCategories" resultMap="productCategoryMap">
        select * from product_category order by sort_order asc
    </select>

    <select id="selectById" resultMap="productCategoryMap">
        select * from product_category where id = #{id}
    </select>

    <select id="selectByParentId" resultMap="productCategoryMap">
        select * from product_category where parent_id = #{parentId} order by sort_order asc
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into product_category(name, parent_id, sort_order, icon, description)
        values(#{name}, #{parentId}, #{sortOrder}, #{icon}, #{description})
    </insert>

    <update id="update">
        update product_category
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        where id = #{id}
    </update>

    <delete id="delete">
        delete from product_category where id = #{id}
    </delete>
</mapper>