<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.item.demo35.Dao.ProductFavoriteDao">
    <resultMap id="productFavoriteMap" type="com.example.item.demo35.entity.ProductFavorite">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="productId" column="product_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <select id="selectByUserId" resultMap="productFavoriteMap">
        select * from product_favorite where user_id = #{userId} order by create_time desc
    </select>

    <select id="selectByUserIdAndProductId" resultMap="productFavoriteMap">
        select * from product_favorite where user_id = #{userId} and product_id = #{productId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into product_favorite(user_id, product_id)
        values(#{userId}, #{productId})
    </insert>

    <delete id="delete">
        delete from product_favorite where user_id = #{userId} and product_id = #{productId}
    </delete>
</mapper>