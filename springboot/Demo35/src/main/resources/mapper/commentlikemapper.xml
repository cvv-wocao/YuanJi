<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.item.demo35.Dao.CommentLikeDao">
    <resultMap id="commentLikeMap" type="com.example.item.demo35.entity.CommentLike">
        <id property="id" column="id"/>
        <result property="commentId" column="comment_id"/>
        <result property="userId" column="user_id"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <insert id="likeComment">
        INSERT INTO comment_like(comment_id, user_id)
        VALUES(#{commentId}, #{userId})
    </insert>

    <delete id="unlikeComment">
        DELETE FROM comment_like WHERE comment_id = #{commentId} AND user_id = #{userId}
    </delete>

    <select id="isLiked" resultType="boolean">
        SELECT COUNT(*) > 0 FROM comment_like
        WHERE comment_id = #{commentId} AND user_id = #{userId}
    </select>

    <select id="selectByCommentId" resultMap="commentLikeMap">
        SELECT * FROM comment_like WHERE comment_id = #{commentId}
    </select>

    <select id="selectByUserId" resultMap="commentLikeMap">
        SELECT * FROM comment_like WHERE user_id = #{userId}
    </select>

    <select id="countByCommentId" resultType="int">
        SELECT COUNT(*) FROM comment_like WHERE comment_id = #{commentId}
    </select>

    <update id="incrementLikeCount">
        UPDATE post_comment SET like_count = like_count + 1 WHERE id = #{id}
    </update>

    <update id="decrementLikeCount">
        UPDATE post_comment SET like_count = like_count - 1 WHERE id = #{id} AND like_count > 0
    </update>
</mapper>
